# LifeShare – Environment variables (EXAMPLE — placeholders only, no real secrets)
# Copy this file to .env and fill in real values before running docker compose.

# ── Web server port (host-side) ──────────────────────────────────────────────
APP_PORT=8080

# ── MySQL root password (required by mysql:8 image) ──────────────────────────
MYSQL_ROOT_PASSWORD=change_me_root

# ── Application database credentials ─────────────────────────────────────────
DB_HOST=mysql
DB_NAME=blood_bank_db
DB_USER=lifeshare
DB_PASSWORD=change_me_app
